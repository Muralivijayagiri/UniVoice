# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Supabase (Client-side / Anon Key only - Never use service-role key)
NEXT_PUBLIC_SUPABASE_URL=****
NEXT_PUBLIC_SUPABASE_ANON_KEY=****

# Comma-separated Auth.js user IDs allowed to manage Supabase connections.
SUPABASE_CONNECTION_STAFF_USER_IDS=

# Set to "true" only after Supabase RLS policies are enabled and verified for
# students and scholarship_applications. While false/absent, the Scholarship
# Section uses local demo data and does not query live scholarship rows.
NEXT_PUBLIC_SUPABASE_RLS_RESOLVED=false
